# Copy to local/.env and fill in. local/.env is git-ignored.

# Claude API key from https://console.anthropic.com. Leave empty to run in rule-based mode (no LLM).
ANTHROPIC_API_KEY=

# Model the agent uses.
AGENT_MODEL=claude-sonnet-5-5

# Key callers must send as the x-api-key header. Leave empty to auto-generate one.
AGENT_API_KEY=

# minikube settings
MINIKUBE_PROFILE=sre-lab
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=4096

# Local ports used by forward.sh
AGENT_PORT=8080
MAILPIT_PORT=8025
ORDER_PORT=8081
PRODUCT_PORT=8082
