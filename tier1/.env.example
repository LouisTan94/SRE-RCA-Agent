# Copy to tier1/.env (git-ignored) and fill in.

# Claude API key from https://console.anthropic.com.
# Used by the in-cluster SRE agent and by the SDLC coding agents.
ANTHROPIC_API_KEY=

# Model for the in-cluster SRE agent.
AGENT_MODEL=claude-sonnet-5-5

# SDLC agents: spend cap per `sdlc.sh task` run (USD), and an optional model override
# (alias such as sonnet / opus, or a full model ID). Empty = SDK default.
SDLC_BUDGET_USD=3
SDLC_MODEL=

# Deploy gate timing (seconds)
VERIFY_SYNC_TIMEOUT=300
VERIFY_SOAK_SECONDS=45

# Local ports used by forward.sh
GITEA_PORT=3000
ARGOCD_PORT=8090
AGENT_PORT=8080
MAILPIT_PORT=8025
